{
  "expo": {
    "name": "Galo Kids POS",
    "slug": "galokids-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "galokids-pos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "\u0628\u06c6 \u0633\u06a9\u06ce\u0646\u06a9\u0631\u062f\u0646\u06cc \u0628\u0627\u0631\u06a9\u06c6\u062f\u06cc \u0628\u06d5\u0631\u0647\u06d5\u0645\u06d5\u06a9\u0627\u0646 \u067e\u06ce\u0648\u06cc\u0633\u062a\u0645\u0627\u0646 \u0628\u06d5 \u06a9\u0627\u0645\u06ce\u0631\u0627\u06cc\u06d5."
        }
      ]
    ],
    "android": {
      "package": "com.galokids.pos",
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.galokids.pos",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}

# SPA fallback for React Router (client-side routing).
# Any request that is NOT an existing file or directory is served index.html,
# so deep links like /about, /products, /track work on a hard refresh.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve real files/directories as-is (assets, /API backend, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else -> index.html (let the SPA handle the route)
    RewriteRule ^ index.html [L]
</IfModule>

# Long-cache the hashed build assets (safe: filenames change on each build)
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

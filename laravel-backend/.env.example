APP_NAME="Galo Kids"
APP_ENV=production
APP_KEY=
# SECURITY: never enable debug in production — it leaks stack traces and config.
APP_DEBUG=false
APP_URL=https://api.galokids.com

# The shop's clock. Leave this as Asia/Baghdad unless the shop moves country —
# reports, invoice numbers and the daily cut-off all follow it.
APP_TIMEZONE=Asia/Baghdad

# The storefront origin(s) allowed to call this API (comma-separated).
FRONTEND_URL=https://galokids.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galokids
DB_USERNAME=galokids
DB_PASSWORD=

# Sanctum: tokens are used via the Authorization: Bearer header.
SANCTUM_STATEFUL_DOMAINS=galokids.com

# Use file-based session/cache so no extra DB tables are required on shared
# hosting. The API rate limiter (throttle) uses the cache store, so if you switch
# CACHE_STORE to "database" you must run the create_cache_table migration.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# OTPIQ SMS / WhatsApp gateway for phone-number verification (OTP).
# Get the key from https://otpiq.com — keep it out of git.
OTPIQ_API_KEY=
OTPIQ_API_URL=https://api.otpiq.com/api/sms

# Delivery route. Leave EMPTY so OTPIQ uses whatever this account is approved
# for. Set it to `whatsapp` only if OTPIQ has enabled WhatsApp on the account —
# asking for a product the account does not have fails every message, and each
# failed message is still charged.
OTPIQ_PROVIDER=

# Staging only: a fixed OTP code accepted for any number. MUST stay empty in
# production, otherwise anyone can log in as any phone number.
OTP_TEST_CODE=

# Browser push notifications for staff (new website orders).
# Generate the pair once with:  php artisan push:keys
# The private key is a secret — never commit it.
VAPID_SUBJECT=https://galokids.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
